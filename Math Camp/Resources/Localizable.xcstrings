    "wp.s3.rem.01" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ hat %2$lld Kekse. %1$@ legt %3$lld Kekse in jede Schachtel. %1$@ füllt so viele Schachteln wie möglich. Wie viele Kekse bleiben übrig?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ has %2$lld cookies. %1$@ puts %3$lld cookies in each box. %1$@ fills as many boxes as possible. How many cookies are left?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ tiene %2$lld galletas. %1$@ pone %3$lld galletas en cada caja. %1$@ llena todas las cajas que puede. ¿Cuántas galletas sobran?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ a %2$lld biscuits. %1$@ met %3$lld biscuits dans chaque boîte. %1$@ remplit autant de boîtes que possible. Combien de biscuits reste-t-il ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ha %2$lld biscotti. %1$@ mette %3$lld biscotti in ogni scatola e riempie più scatole possibile. Quanti biscotti avanzano?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@さんは クッキーを %2$lld枚 もっています。はこ1つに %3$lld枚ずつ 入れて、できるだけ たくさんの はこを いっぱいにします。クッキーは なん枚 あまりますか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ har %2$lld kjeks. %1$@ legger %3$lld kjeks i hver eske. %1$@ fyller så mange esker som mulig. Hvor mange kjeks blir til overs?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ma %2$lld ciasteczek. %1$@ wkłada po %3$lld ciasteczek do każdego pudełka. %1$@ zapełnia tyle pudełek, ile się da. Ile ciasteczek zostaje?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ tem %2$lld biscoitos. %1$@ coloca %3$lld biscoitos em cada caixa. %1$@ enche o máximo de caixas possível. Quantos biscoitos sobram?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ har %2$lld kakor. %1$@ lägger %3$lld kakor i varje ask. %1$@ fyller så många askar som möjligt. Hur många kakor blir över?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "У %1$@ печива: %2$lld. %1$@ кладе в кожну коробку по %3$lld. %1$@ заповнює якомога більше коробок. Скільки печива залишається?"
          }
        }
      }
    },
    "wp.s3.rem.02" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es sind %1$lld Wanderer da. In jedem Zelt ist Platz für %2$lld Wanderer. Die Wanderer füllen so viele Zelte wie möglich. Wie viele Wanderer haben kein Zelt?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are %1$lld hikers. Each tent has space for %2$lld hikers. The hikers fill as many tents as possible. How many hikers are left without a tent?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hay %1$lld excursionistas. En cada tienda de campaña caben %2$lld excursionistas. Los excursionistas llenan todas las tiendas que pueden. ¿Cuántos excursionistas se quedan sin tienda?"
          }
