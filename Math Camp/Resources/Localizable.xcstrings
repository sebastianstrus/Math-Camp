    "wp.s1.two.02" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Im Camp sind %1$lld Wanderer. Noch %2$lld Wanderer kommen an. Dann gehen %3$lld Wanderer weg. Wie viele Wanderer sind jetzt im Camp?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are %1$lld hikers at the camp. %2$lld more hikers arrive. Then %3$lld hikers leave. How many hikers are at the camp now?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hay %1$lld excursionistas en el campamento. Llegan %2$lld excursionistas más. Luego se van %3$lld excursionistas. ¿Cuántos excursionistas hay ahora en el campamento?"
