    "wp.s1.add.01" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ hat %2$lld Tannenzapfen. %1$@ findet %3$lld Tannenzapfen dazu. Wie viele Tannenzapfen hat %1$@ jetzt?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ has %2$lld pine cones. %1$@ finds %3$lld more pine cones. How many pine cones does %1$@ have now?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ tiene %2$lld piñas. %1$@ encuentra %3$lld piñas más. ¿Cuántas piñas tiene ahora %1$@?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ a %2$lld pommes de pin. %1$@ en trouve %3$lld de plus. Combien de pommes de pin %1$@ a-t-il maintenant ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ha %2$lld pigne. %1$@ ne trova altre %3$lld. Quante pigne ha adesso %1$@?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@さんは まつぼっくりを %2$lld個 もっています。%1$@さんは まつぼっくりを %3$lld個 ひろいました。%1$@さんの まつぼっくりは いま なん個ですか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ har %2$lld kongler. %1$@ finner %3$lld kongler til. Hvor mange kongler har %1$@ nå?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ma %2$lld szyszek. %1$@ znajduje jeszcze %3$lld szyszek. Ile szyszek ma teraz %1$@?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ tem %2$lld pinhas. %1$@ encontra mais %3$lld pinhas. Com quantas pinhas %1$@ fica agora?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ har %2$lld tallkottar. %1$@ hittar %3$lld tallkottar till. Hur många tallkottar har %1$@ nu?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ має шишки: %2$lld. %1$@ знаходить ще шишки: %3$lld. Скільки шишок тепер має %1$@?"
          }
        }
      }
    },
    "wp.s1.add.02" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Auf einem Baum sitzen %1$lld Vögel. Noch %2$lld Vögel setzen sich auf den Baum. Wie viele Vögel sitzen jetzt auf dem Baum?"
          }
