        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Al campeggio ci sono %1$lld escursionisti. La mattina ne arrivano altri %2$lld. La sera %3$lld escursionisti se ne vanno. Quanti escursionisti ci sono adesso al campeggio?"
