        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un campamento tiene %1$lld excursionistas. Por la mañana llegan %2$lld excursionistas. Por la tarde se van %3$lld excursionistas. ¿Cuántos excursionistas hay ahora en el campamento?"
          }
