        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ロープの 長さは %2$lld cmです。%1$@さんは ロープに %3$lld cmの ロープを つなぎます。ロープの 長さは いま なん cmですか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Et tau er %2$lld cm langt. %1$@ fester en bit på %3$lld cm til tauet. Hvor langt er tauet nå, i cm?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lina ma %2$lld cm długości. %1$@ dowiązuje do liny kawałek o długości %3$lld cm. Ile cm długości ma teraz lina?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uma corda tem %2$lld cm de comprimento. %1$@ junta um pedaço de %3$lld cm à corda. Quantos cm a corda tem agora?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ett rep är %2$lld cm långt. %1$@ lägger till en bit på %3$lld cm på repet. Hur långt är repet nu, i cm?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Довжина мотузки — %2$lld см. %1$@ додає до мотузки шматок довжиною %3$lld см. Яка тепер довжина мотузки, у см?"
          }
        }
      }
    },
    "wp.s6.add.03" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eine Tüte Äpfel wiegt %1$lld g. Eine Tüte Birnen wiegt %2$lld g. Wie viele g wiegen beide Tüten zusammen?"
          }
        },
        "en" : {
