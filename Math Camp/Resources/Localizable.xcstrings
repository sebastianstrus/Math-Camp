        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En pose veier %2$lld g. %1$@ legger %3$lld g steiner i posen. Deretter tar %1$@ ut %4$lld g. Hvor mange g veier posen nå?"
