    "wp.s3.tms.03" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Auf einem kleinen Baum sitzen %1$lld Vögel. Auf einem großen Baum sitzen %2$lld-mal so viele Vögel. Wie viele Vögel sitzen auf dem großen Baum?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are %1$lld birds on a small tree. There are %2$lld times as many birds on a big tree. How many birds are on the big tree?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hay %1$lld pájaros en un árbol pequeño. En un árbol grande hay %2$lld veces más pájaros. ¿Cuántos pájaros hay en el árbol grande?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il y a %1$lld oiseaux sur un petit arbre. Il y a %2$lld fois plus d’oiseaux sur un grand arbre. Combien y a-t-il d’oiseaux sur le grand arbre ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Su un albero piccolo ci sono %1$lld uccellini. Su un albero grande ce ne sono %2$lld volte di più. Quanti uccellini ci sono sull'albero grande?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "小さい木に とりが %1$lld羽 います。大きい木には その %2$lld倍の とりが います。大きい木に とりは なん羽 いますか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Det er %1$lld fugler i et lite tre. Det er %2$lld ganger så mange fugler i et stort tre. Hvor mange fugler er det i det store treet?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Na małym drzewie siedzi %1$lld ptaków. Na dużym drzewie siedzi %2$lld razy więcej ptaków. Ile ptaków siedzi na dużym drzewie?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Há %1$lld pássaros em uma árvore pequena. Há %2$lld vezes mais pássaros em uma árvore grande. Quantos pássaros há na árvore grande?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I ett litet träd sitter %1$lld fåglar. I ett stort träd sitter %2$lld gånger så många fåglar. Hur många fåglar sitter i det stora trädet?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "На маленькому дереві птахів: %1$lld. На великому дереві птахів більше у %2$lld разів. Скільки птахів на великому дереві?"
          }
        }
      }
    },
    "wp.s3.up.01" : {
