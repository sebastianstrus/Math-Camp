        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Det er %1$lld fisker i en innsjø. %2$lld fisker svømmer bort. Hvor mange fisker er det i innsjøen nå?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "W jeziorze pływa %1$lld ryb. Odpływa %2$lld ryb. Ile ryb pływa teraz w jeziorze?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Há %1$lld peixes em um lago. %2$lld peixes vão embora nadando. Quantos peixes há no lago agora?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
