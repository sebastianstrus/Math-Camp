    "onboarding.1.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Übe Mathe auf einer Reise den Berg hinauf. Jede Aufgabe ist ein kleiner Schritt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practice maths on a trip up the mountain. Every task is a small step."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Practica matemáticas en un viaje montaña arriba. Cada tarea es un pequeño paso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Entraîne-toi en maths pendant une montée de la montagne. Chaque tâche est un petit pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fai pratica con la matematica in un viaggio su per la montagna. Ogni compito è un piccolo passo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "山のぼりをしながら、算数のれんしゅうをしましょう。ひとつひとつの問題が、小さな一歩です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Øv på matte på en tur opp fjellet. Hver oppgave er et lite steg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ćwicz matematykę podczas wyprawy na górę. Każde zadanie to mały krok."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pratique matemática em uma viagem montanha acima. Cada tarefa é um pequeno passo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öva matte på en resa uppför berget. Varje uppgift är ett litet steg."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Тренуй математику під час подорожі на гору. Кожне завдання — це маленький крок."
          }
        }
      }
    },
