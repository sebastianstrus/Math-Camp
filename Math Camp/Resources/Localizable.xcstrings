        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Et tau er %2$lld cm langt. %1$@ klipper av %3$lld cm. Deretter klipper %1$@ av %4$lld cm til. Hvor langt er tauet nå, i cm?"
          }
        },
