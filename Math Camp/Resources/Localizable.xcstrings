    "wp.s6.add.01" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ wandert am Morgen %2$lld Min. lang. %1$@ wandert am Nachmittag %3$lld Min. lang. Wie viele Minuten wandert %1$@ insgesamt?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hikes for %2$lld min in the morning. %1$@ hikes for %3$lld min in the afternoon. For how many minutes does %1$@ hike in total?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ camina durante %2$lld min por la mañana. %1$@ camina durante %3$lld min por la tarde. ¿Durante cuántos minutos camina %1$@ en total?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ marche pendant %2$lld min le matin. %1$@ marche pendant %3$lld min l’après-midi. Pendant combien de minutes %1$@ marche-t-il en tout ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ fa un'escursione di %2$lld min al mattino. %1$@ cammina per altri %3$lld min nel pomeriggio. Per quanti minuti cammina %1$@ in tutto?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@さんは 午前に %2$lld分 ハイキングを します。午後に %3$lld分 ハイキングを します。ぜんぶで なん分 ハイキングを しますか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ går tur i %2$lld min om formiddagen. %1$@ går tur i %3$lld min om ettermiddagen. Hvor mange minutter går %1$@ tur til sammen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ idzie na wycieczkę przez %2$lld min rano. Po południu %1$@ idzie przez %3$lld min. Ile minut w sumie trwa wycieczka %1$@?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ faz trilha por %2$lld min de manhã. %1$@ faz trilha por %3$lld min à tarde. Por quantos minutos %1$@ faz trilha ao todo?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ vandrar i %2$lld min på förmiddagen. %1$@ vandrar i %3$lld min på eftermiddagen. Hur många minuter vandrar %1$@ sammanlagt?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ іде в похід %2$lld хв уранці. %1$@ іде в похід %3$lld хв по обіді. Скільки хвилин усього %1$@ іде в поході?"
          }
        }
      }
    },
    "wp.s6.add.02" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Seil ist %2$lld cm lang. %1$@ hängt ein Stück von %3$lld cm an das Seil. Wie lang ist das Seil jetzt, in cm?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
