          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ har %2$lld äpplen. %1$@ ger hälften av äpplena till en kompis. Hur många äpplen ger %1$@ bort?"
          }
        },
