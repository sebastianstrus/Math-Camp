        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ har %2$lld klistremerker. %1$@ får %3$lld klistremerker til på mandag og %4$lld klistremerker til på tirsdag. Hvor mange klistremerker har %1$@ nå?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ma %2$lld naklejek. W poniedziałek %1$@ dostaje jeszcze %3$lld naklejek, a we wtorek jeszcze %4$lld naklejek. Ile naklejek ma teraz %1$@?"
