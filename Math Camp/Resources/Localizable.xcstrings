          }
        }
      }
    },
    "wp.s6.add.04" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In einer Flasche sind %2$lld ml Wasser. %1$@ füllt noch %3$lld ml Wasser in die Flasche. Wie viele ml Wasser sind jetzt in der Flasche?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bottle has %2$lld ml of water. %1$@ adds %3$lld ml more water to the bottle. How many ml of water are in the bottle now?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una botella tiene %2$lld ml de agua. %1$@ le echa %3$lld ml más de agua. ¿Cuántos ml de agua hay ahora en la botella?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une bouteille contient %2$lld ml d’eau. %1$@ ajoute encore %3$lld ml d’eau dans la bouteille. Combien de ml d’eau y a-t-il maintenant dans la bouteille ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una bottiglia ha %2$lld ml di acqua. %1$@ aggiunge altri %3$lld ml di acqua nella bottiglia. Quanti ml di acqua ci sono ora nella bottiglia?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "びんに 水が %2$lld ml 入っています。%1$@さんは びんに 水を %3$lld ml たします。びんの 水は いま なん mlですか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En flaske har %2$lld ml vann. %1$@ heller %3$lld ml mer vann i flasken. Hvor mange ml vann er det i flasken nå?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "W butelce jest %2$lld ml wody. %1$@ dolewa do butelki jeszcze %3$lld ml wody. Ile ml wody jest teraz w butelce?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uma garrafa tem %2$lld ml de água. %1$@ coloca mais %3$lld ml de água na garrafa. Quantos ml de água há na garrafa agora?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En flaska innehåller %2$lld ml vatten. %1$@ häller i %3$lld ml vatten till. Hur många ml vatten är det i flaskan nu?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "У пляшці %2$lld мл води. %1$@ доливає в пляшку ще %3$lld мл води. Скільки мілілітрів води тепер у пляшці?"
          }
        }
      }
    },
    "wp.s6.cmp.01" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ geht %3$lld m. %2$@ geht %4$lld m. Wie viele m mehr geht %1$@ als %2$@?"
