            "state" : "machine_translated",
            "value" : "Une corde mesure %2$lld cm. %1$@ coupe %3$lld cm. Ensuite, %1$@ coupe encore %4$lld cm. Quelle est la longueur de la corde maintenant, en cm ?"
          }
