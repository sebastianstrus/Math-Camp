    "wp.s4.add.01" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ geht am Morgen %2$lld Schritte. Am Nachmittag geht %1$@ noch %3$lld Schritte. Wie viele Schritte geht %1$@ insgesamt?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ walks %2$lld steps in the morning. %1$@ walks %3$lld more steps in the afternoon. How many steps does %1$@ walk in total?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ da %2$lld pasos por la mañana. %1$@ da %3$lld pasos más por la tarde. ¿Cuántos pasos da %1$@ en total?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ marche %2$lld pas le matin. %1$@ marche encore %3$lld pas l’après-midi. Combien de pas %1$@ marche-t-il ou elle en tout ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ fa %2$lld passi al mattino. %1$@ fa altri %3$lld passi al pomeriggio. Quanti passi fa %1$@ in tutto?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@さんは 午前に %2$lld歩 あるきました。午後に さらに %3$lld歩 あるきました。あわせて なん歩 あるきましたか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ går %2$lld skritt om morgenen. %1$@ går %3$lld skritt til om ettermiddagen. Hvor mange skritt går %1$@ til sammen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ idzie rano %2$lld kroków. Po południu %1$@ idzie jeszcze %3$lld kroków. Ile kroków robi %1$@ razem?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ caminha %2$lld passos de manhã. %1$@ caminha mais %3$lld passos à tarde. Quantos passos %1$@ caminha ao todo?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ går %2$lld steg på morgonen. På eftermiddagen går %1$@ ytterligare %3$lld steg. Hur många steg går %1$@ totalt?"
          }
        },
        "uk" : {
