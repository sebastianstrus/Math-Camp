    "wp.s2.two.03" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ hat %2$lld Karten. %1$@ bekommt am Montag noch %3$lld Karten. %1$@ bekommt am Dienstag noch %4$lld Karten. Wie viele Karten hat %1$@ jetzt?"
