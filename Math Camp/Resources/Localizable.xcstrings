    "onboarding.2.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vom Zählen bis zu Brüchen, Zeit und Rätseln. An jeder Station lernst du etwas Neues."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From counting to fractions, time and puzzles. Each stop teaches new skills."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Desde contar hasta fracciones, tiempo y acertijos. En cada parada aprendes algo nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du comptage aux fractions, en passant par le temps et les casse-tête. Chaque étape t’apprend de nouvelles choses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dal contare alle frazioni, dal tempo agli enigmi. Ogni tappa ti insegna cose nuove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "数えることから、分数、時間、パズルまで。立ち止まるたびに、新しい力が身につきます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fra telling til brøker, tid og gåter. Hvert stopp lærer deg noe nytt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Od liczenia po ułamki, czas i łamigłówki. Każdy przystanek uczy nowych umiejętności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De contar a frações, tempo e desafios. Cada parada ensina novas habilidades."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Från att räkna till bråk, tid och pussel. Varje stopp lär dig något nytt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Від лічби до дробів, часу та головоломок. Кожна зупинка вчить нових умінь."
          }
        }
      }
    },
    "onboarding.2.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sieben Stationen auf dem Weg"
          }
        },
        "en" : {
