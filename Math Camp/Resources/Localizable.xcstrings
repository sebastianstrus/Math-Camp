        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "キャンプ場に テントが %1$lld張 あります。5分の1の テントが 青です。青い テントは なん張ですか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En leir har %1$lld telt. En femtedel av teltene er blå. Hvor mange telt er blå?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Na obozie jest %1$lld namiotów. Jedna piąta namiotów jest niebieska. Ile namiotów jest niebieskich?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um acampamento tem %1$lld barracas. Um quinto das barracas é azul. Quantas barracas são azuis?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ett läger har %1$lld tält. En femtedel av tälten är blå. Hur många tält är blå?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "У таборі %1$lld наметів. П’ята частина наметів синя. Скільки наметів синіх?"
          }
        }
      }
    },
