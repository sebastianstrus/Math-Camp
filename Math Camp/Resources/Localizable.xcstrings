            "state" : "machine_translated",
            "value" : "%1$@ tiene %2$lld cartas. El lunes %1$@ recibe %3$lld cartas más. El martes %1$@ recibe %4$lld cartas más. ¿Cuántas cartas tiene ahora %1$@?"
