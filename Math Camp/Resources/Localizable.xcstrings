        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il y a %1$lld oiseaux sur un arbre. %2$lld autres oiseaux se posent sur l’arbre. Ensuite, %3$lld oiseaux s’envolent. Combien d’oiseaux y a-t-il maintenant sur l’arbre ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Su un albero ci sono %1$lld uccellini. Altri %2$lld uccellini si posano sull'albero. Poi %3$lld uccellini volano via. Quanti uccellini ci sono adesso sull'albero?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "木に とりが %1$lld羽 とまっています。そこへ %2$lld羽 とんできました。そのあと %3$lld羽 とんでいきました。いま 木に とりは なん羽 いますか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Det sitter %1$lld fugler i et tre. %2$lld fugler til lander i treet. Så flyr %3$lld fugler bort. Hvor mange fugler sitter i treet nå?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Na drzewie siedzi %1$lld ptaków. Przylatuje jeszcze %2$lld ptaków. Potem odlatuje %3$lld ptaków. Ile ptaków siedzi teraz na drzewie?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Há %1$lld passarinhos em uma árvore. Mais %2$lld passarinhos pousam na árvore. Depois, %3$lld passarinhos saem voando. Quantos passarinhos há na árvore agora?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Det sitter %1$lld fåglar i ett träd. %2$lld fåglar till landar i trädet. Sedan flyger %3$lld fåglar iväg. Hur många fåglar sitter i trädet nu?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Птахів на дереві: %1$lld. Прилітають ще птахи: %2$lld. Потім відлітають птахи: %3$lld. Скільки птахів тепер на дереві?"
          }
        }
      }
