    "wp.s2.two.04" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Auf einem Baum sitzen %1$lld Vögel. Noch %2$lld Vögel setzen sich auf den Baum. Dann fliegen %3$lld Vögel weg. Wie viele Vögel sitzen jetzt auf dem Baum?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are %1$lld birds on a tree. %2$lld more birds land on the tree. Then %3$lld birds fly away. How many birds are on the tree now?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hay %1$lld pájaros en un árbol. Se posan %2$lld pájaros más en el árbol. Luego se van volando %3$lld pájaros. ¿Cuántos pájaros hay ahora en el árbol?"
