          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "りんごの ふくろは %1$lld gです。洋なしの ふくろは %2$lld gです。2つの ふくろを あわせると なん gですか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En pose epler veier %1$lld g. En pose pærer veier %2$lld g. Hvor mange g veier begge posene til sammen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Torba jabłek waży %1$lld g. Torba gruszek waży %2$lld g. Ile g ważą obie torby razem?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um saco de maçãs pesa %1$lld g. Um saco de peras pesa %2$lld g. Quantos g os dois sacos pesam juntos?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En påse äpplen väger %1$lld g. En påse päron väger %2$lld g. Hur många g väger båda påsarna tillsammans?"
          }
