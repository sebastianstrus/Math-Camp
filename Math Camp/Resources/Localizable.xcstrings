            "value" : "Сім зупинок на стежці"
          }
        }
      }
    },
    "onboarding.3.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jede Kategorie hat 30 Aufgaben. Aufwärmen ist leicht, Aufstieg bietet alles und Gipfel ist am schwersten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every category has 30 tasks. Warm-up is easy, Climb is the full range and Peak is the hardest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cada categoría tiene 30 tareas. Calentamiento es fácil, Ascenso incluye de todo y Cima es lo más difícil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chaque catégorie a 30 tâches. Échauffement est facile, Ascension couvre tout et Sommet est le plus difficile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ogni categoria ha 30 compiti. Riscaldamento è facile, Salita comprende tutto e Vetta è la più difficile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "どのカテゴリーにも30問あります。ウォームアップはかんたん、クライムはすべてのはんい、ピークはいちばんむずかしいです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hver kategori har 30 oppgaver. Oppvarming er lett, Klatring har alle slags tall og Toppen er det vanskeligste."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Każda kategoria ma 30 zadań. Rozgrzewka jest łatwa, Wspinaczka obejmuje pełny zakres, a Szczyt jest najtrudniejszy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cada categoria tem 30 tarefas. Aquecimento é fácil, Subida tem de tudo um pouco e Pico é o mais difícil."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Varje kategori har 30 uppgifter. Uppvärmning är lätt, Klättring har allt och Topp är svårast."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "У кожній категорії по 30 завдань. Розминка — легка, Підйом — усі рівні складності, а Вершина — найважча."
          }
        }
      }
    },
