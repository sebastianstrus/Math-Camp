    "wp.s4.add.04" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ liest in einer Woche %2$lld Seiten. In der nächsten Woche liest %1$@ %3$lld Seiten. Wie viele Seiten liest %1$@ insgesamt?"
          }
        },
