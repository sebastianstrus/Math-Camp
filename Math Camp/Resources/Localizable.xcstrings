    "wp.s6.two.01" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ geht %2$lld Min. lang. %1$@ ruht sich %3$lld Min. lang aus. Dann geht %1$@ noch %4$lld Min. lang. Wie viele Minuten dauert das alles zusammen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ walks for %2$lld min. %1$@ rests for %3$lld min. Then %1$@ walks for %4$lld min. How many minutes does all of this take?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ camina durante %2$lld min. %1$@ descansa durante %3$lld min. Después %1$@ camina durante %4$lld min. ¿Cuántos minutos dura todo esto?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ marche pendant %2$lld min. %1$@ se repose pendant %3$lld min. Ensuite, %1$@ marche pendant %4$lld min. Combien de minutes tout cela dure-t-il ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ cammina per %2$lld min. %1$@ si riposa per %3$lld min. Poi %1$@ cammina per %4$lld min. Quanti minuti passano in tutto?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@さんは %2$lld分 あるきます。%1$@さんは %3$lld分 やすみます。それから %1$@さんは %4$lld分 あるきます。ぜんぶで なん分 かかりますか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ går i %2$lld min. %1$@ hviler i %3$lld min. Deretter går %1$@ i %4$lld min. Hvor mange minutter tar alt dette?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ idzie przez %2$lld min. %1$@ odpoczywa przez %3$lld min. Potem %1$@ idzie jeszcze przez %4$lld min. Ile minut trwa to wszystko?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ anda por %2$lld min. %1$@ descansa por %3$lld min. Depois, %1$@ anda por %4$lld min. Quantos minutos tudo isso leva?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ går i %2$lld min. %1$@ vilar i %3$lld min. Sedan går %1$@ i %4$lld min. Hur många minuter tar allt detta?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ іде %2$lld хв. %1$@ відпочиває %3$lld хв. Потім %1$@ іде ще %4$lld хв. Скільки хвилин усе це триває?"
          }
        }
      }
    },
    "wp.s6.two.02" : {
