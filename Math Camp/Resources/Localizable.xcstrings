          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ tiene %2$lld canicas. %1$@ pone %3$lld canicas en una caja y %4$lld canicas en una bolsa. ¿Cuántas canicas tiene %1$@ ahora?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ a %2$lld billes. %1$@ met %3$lld billes dans une boîte et %4$lld billes dans un sac. Combien de billes %1$@ a-t-il ou elle maintenant ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ha %2$lld biglie. %1$@ ne mette %3$lld in una scatola e %4$lld in un sacchetto. Quante biglie ha ora %1$@?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@さんは ビー玉を %2$lld個 もっています。はこに %3$lld個、ふくろに %4$lld個 入れました。%1$@さんの ビー玉は いま なん個 のこっていますか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ har %2$lld kuler. %1$@ legger %3$lld kuler i en eske og %4$lld kuler i en pose. Hvor mange kuler har %1$@ nå?"
