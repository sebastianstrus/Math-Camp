        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un sentiero ha %1$lld sassi. Con la pioggia ne rotolano via %2$lld. Quanti sassi ci sono ora sul sentiero?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "山道に 石が %1$lld個 あります。雨で 石が %2$lld個 ころがっていきました。いま 山道に 石は なん個 ありますか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En sti har %1$lld steiner. %2$lld steiner ruller bort i regnet. Hvor mange steiner er det på stien nå?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Na szlaku leży %1$lld kamieni. Podczas deszczu %2$lld kamieni stacza się w dół. Ile kamieni leży teraz na szlaku?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uma trilha tem %1$lld pedras. %2$lld pedras rolam com a chuva. Quantas pedras há na trilha agora?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "På en stig ligger %1$lld stenar. %2$lld stenar rullar bort i regnet. Hur många stenar ligger på stigen nu?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "На стежці каменів: %1$lld. Під час дощу скочуються каменів: %2$lld. Скільки каменів тепер на стежці?"
          }
        }
      }
    },
