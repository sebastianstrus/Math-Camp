        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il y a %1$lld randonneurs au camp. %2$lld autres randonneurs arrivent. Ensuite, %3$lld randonneurs partent. Combien de randonneurs y a-t-il maintenant au camp ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Al campeggio ci sono %1$lld escursionisti. Ne arrivano altri %2$lld. Poi %3$lld escursionisti se ne vanno. Quanti escursionisti ci sono adesso al campeggio?"
