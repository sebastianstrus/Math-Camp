        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una bolsa de manzanas pesa %1$lld g. Una bolsa de peras pesa %2$lld g. ¿Cuántos g pesan las dos bolsas juntas?"
          }
        },
        "fr" : {
          "stringUnit" : {
