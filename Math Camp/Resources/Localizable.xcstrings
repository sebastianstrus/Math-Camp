    "wp.s4.two.01" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Camp hat %1$lld Wanderer. Am Montag kommen %2$lld Wanderer an. Am Dienstag gehen %3$lld Wanderer weg. Wie viele Wanderer sind jetzt im Camp?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A camp has %1$lld hikers. %2$lld hikers arrive on Monday. %3$lld hikers leave on Tuesday. How many hikers are at the camp now?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un campamento tiene %1$lld excursionistas. El lunes llegan %2$lld excursionistas. El martes se van %3$lld excursionistas. ¿Cuántos excursionistas hay ahora en el campamento?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un camp a %1$lld randonneurs. %2$lld randonneurs arrivent le lundi. %3$lld randonneurs partent le mardi. Combien y a-t-il de randonneurs au camp maintenant ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un campeggio ha %1$lld escursionisti. Lunedì ne arrivano %2$lld. Martedì ne partono %3$lld. Quanti escursionisti ci sono ora al campeggio?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "キャンプ場に ハイカーが %1$lld人 います。月曜日に %2$lld人 ついました。火曜日に %3$lld人 かえりました。いま キャンプ場に ハイカーは なん人 いますか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En leir har %1$lld turgåere. Det kommer %2$lld turgåere på mandag. %3$lld turgåere reiser på tirsdag. Hvor mange turgåere er i leiren nå?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Na obozie jest %1$lld turystów. W poniedziałek przyjeżdża %2$lld turystów. We wtorek wyjeżdża %3$lld turystów. Ilu turystów jest teraz na obozie?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um acampamento tem %1$lld caminhantes. Na segunda-feira chegam %2$lld caminhantes. Na terça-feira saem %3$lld caminhantes. Quantos caminhantes há no acampamento agora?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ett läger har %1$lld vandrare. På måndagen kommer %2$lld vandrare. På tisdagen reser %3$lld vandrare hem. Hur många vandrare är på lägret nu?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "У таборі туристів: %1$lld. У понеділок приходять туристів: %2$lld. У вівторок йдуть туристів: %3$lld. Скільки туристів тепер у таборі?"
          }
        }
      }
    },
    "wp.s4.two.02" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ hat %2$lld Murmeln. %1$@ legt %3$lld Murmeln in eine Schachtel und %4$lld Murmeln in eine Tasche. Wie viele Murmeln hat %1$@ jetzt?"
          }
        },
        "en" : {
