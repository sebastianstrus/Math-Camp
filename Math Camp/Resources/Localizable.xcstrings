        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ walks %3$lld m. %2$@ walks %4$lld m. How many more m does %1$@ walk than %2$@?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ camina %3$lld m. %2$@ camina %4$lld m. ¿Cuántos m más camina %1$@ que %2$@?"
