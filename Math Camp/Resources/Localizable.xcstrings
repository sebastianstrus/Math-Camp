        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ tiene %2$lld pegatinas. El lunes %1$@ recibe %3$lld pegatinas más y el martes %4$lld pegatinas más. ¿Cuántas pegatinas tiene %1$@ ahora?"
