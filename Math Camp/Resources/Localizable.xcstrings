    "wp.s2.sub.01" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In einem See schwimmen %1$lld Fische. %2$lld Fische schwimmen weg. Wie viele Fische sind jetzt im See?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are %1$lld fish in a lake. %2$lld fish swim away. How many fish are in the lake now?"
