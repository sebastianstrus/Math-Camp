        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In einem Camp sind %1$lld Wanderer. Am Morgen kommen %2$lld Wanderer an. Am Abend gehen %3$lld Wanderer weg. Wie viele Wanderer sind jetzt im Camp?"
          }
