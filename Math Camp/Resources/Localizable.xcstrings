        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ ma %2$lld kulek. %1$@ wkłada %3$lld kulek do pudełka i %4$lld kulek do woreczka. Ile kulek zostaje teraz u %1$@?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ tem %2$lld bolinhas de gude. %1$@ coloca %3$lld bolinhas em uma caixa e %4$lld bolinhas em um saco. Quantas bolinhas de gude %1$@ tem agora?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ har %2$lld kulor. %1$@ lägger %3$lld kulor i en ask och %4$lld kulor i en påse. Hur många kulor har %1$@ nu?"
          }
        },
        "uk" : {
          "stringUnit" : {
