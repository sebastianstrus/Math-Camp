    "wp.s4.two.04" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Auf einem See sind %1$lld Vögel. Noch %2$lld Vögel landen auf dem See. Dann fliegen %3$lld Vögel weg. Wie viele Vögel sind jetzt auf dem See?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are %1$lld birds on a lake. %2$lld more birds land on the lake. Then %3$lld birds fly away. How many birds are on the lake now?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hay %1$lld pájaros en un lago. Se posan %2$lld pájaros más en el lago. Luego se van volando %3$lld pájaros. ¿Cuántos pájaros hay ahora en el lago?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il y a %1$lld oiseaux sur un lac. %2$lld oiseaux de plus se posent sur le lac. Puis %3$lld oiseaux s’envolent. Combien y a-t-il d’oiseaux sur le lac maintenant ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Su un lago ci sono %1$lld uccellini. Altri %2$lld uccellini si posano sul lago. Poi %3$lld uccellini volano via. Quanti uccellini ci sono ora sul lago?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "みずうみに とりが %1$lld羽 います。そこへ %2$lld羽 とんできました。そのあと %3$lld羽 とんでいきました。いま みずうみに とりは なん羽 いますか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Det er %1$lld fugler på en innsjø. %2$lld fugler til lander på innsjøen. Så flyr %3$lld fugler bort. Hvor mange fugler er det på innsjøen nå?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Na jeziorze pływa %1$lld ptaków. Siada na nim jeszcze %2$lld ptaków. Potem %3$lld ptaków odlatuje. Ile ptaków pływa teraz na jeziorze?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Há %1$lld pássaros em um lago. Mais %2$lld pássaros pousam no lago. Depois, %3$lld pássaros vão embora voando. Quantos pássaros há no lago agora?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "På en sjö simmar %1$lld fåglar. Ytterligare %2$lld fåglar landar på sjön. Sedan flyger %3$lld fåglar iväg. Hur många fåglar är på sjön nu?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "На озері птахів: %1$lld. На озеро сідають ще птахів: %2$lld. Потім відлітають птахів: %3$lld. Скільки птахів тепер на озері?"
          }
        }
      }
    },
    "wp.s5.fifth.01" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Camp hat %1$lld Zelte. Ein Fünftel der Zelte ist blau. Wie viele Zelte sind blau?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A camp has %1$lld tents. A fifth of the tents are blue. How many tents are blue?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un campamento tiene %1$lld tiendas de campaña. Una quinta parte de las tiendas son azules. ¿Cuántas tiendas son azules?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un camp a %1$lld tentes. Un cinquième des tentes est bleu. Combien de tentes sont bleues ?"
