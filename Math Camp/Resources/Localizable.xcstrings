        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Det er %1$lld turgåere på leiren. %2$lld turgåere til kommer. Så drar %3$lld turgåere. Hvor mange turgåere er det på leiren nå?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Na obozie jest %1$lld wędrowców. Przybywa jeszcze %2$lld wędrowców. Potem odchodzi %3$lld wędrowców. Ilu wędrowców jest teraz na obozie?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Há %1$lld caminhantes no acampamento. Chegam mais %2$lld caminhantes. Depois, %3$lld caminhantes vão embora. Quantos caminhantes há no acampamento agora?"
          }
        },
        "sv" : {
          "stringUnit" : {
