          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una cuerda mide %2$lld cm de largo. %1$@ le añade un trozo de %3$lld cm. ¿Cuánto mide ahora la cuerda, en cm?"
