    "wp.s4.sub.01" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Auf einem Weg liegen %1$lld Steine. Im Regen rollen %2$lld Steine weg. Wie viele Steine liegen jetzt auf dem Weg?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A trail has %1$lld stones. %2$lld stones roll away in the rain. How many stones are on the trail now?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un sendero tiene %1$lld piedras. %2$lld piedras ruedan con la lluvia. ¿Cuántas piedras hay ahora en el sendero?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un sentier a %1$lld pierres. %2$lld pierres roulent au loin sous la pluie. Combien y a-t-il de pierres sur le sentier maintenant ?"
